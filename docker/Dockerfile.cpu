ARG PYTHON_IMAGE=ghcr.io/astral-sh/uv:python3.11-bookworm-slim
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.11.28

FROM ${UV_IMAGE} AS uv-bin

FROM ${PYTHON_IMAGE} AS builder

COPY --from=uv-bin /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_CACHE_DIR=/tmp/uv-cache

WORKDIR /app

COPY pyproject.toml uv.lock README.md DEVELOPMENT_PLAN.md AGENTS.md ./
COPY configs ./configs
COPY data ./data
COPY examples ./examples
COPY scripts ./scripts
COPY src ./src

RUN uv sync --frozen --no-dev

FROM ${PYTHON_IMAGE} AS runtime

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    CPICANN_MODEL_DIR=/app/models \
    CPICANN_API_RUN_ROOT=/app/runs/api \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

WORKDIR /app

RUN addgroup --system --gid 10001 cpicann \
    && adduser --system --uid 10001 --ingroup cpicann --home /app --shell /usr/sbin/nologin cpicann \
    && mkdir -p /app/models /app/runs /app/.streamlit \
    && chown -R cpicann:cpicann /app

COPY --from=builder --chown=cpicann:cpicann /app /app

USER cpicann

EXPOSE 8501 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD cpicann-xrd doctor --backend fake >/dev/null || exit 1

CMD ["streamlit", "run", "src/cpicann_xrd/web/app.py", "--server.address", "0.0.0.0", "--server.port", "8501", "--server.headless", "true", "--browser.gatherUsageStats", "false"]
